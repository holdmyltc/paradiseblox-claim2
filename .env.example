# Public site
NEXT_PUBLIC_SITE_URL=https://claim2.paradiseblox.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_DEMO_MODE=true

# Server-only Supabase
# Use the new sb_secret_ key. The legacy SUPABASE_SERVICE_ROLE_KEY is also supported.
SUPABASE_SECRET_KEY=sb_secret_xxx
CUSTOMER_SESSION_SECRET=replace-with-at-least-32-random-bytes
EMAIL_CODE_SECRET=replace-with-a-different-random-secret

# Shopify Dev Dashboard app
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=YOUR_SHOPIFY_CLIENT_ID
SHOPIFY_CLIENT_SECRET=YOUR_SHOPIFY_CLIENT_SECRET
SHOPIFY_API_VERSION=2026-07
# Optional. If blank, SHOPIFY_CLIENT_SECRET is used for webhook HMAC verification.
SHOPIFY_WEBHOOK_SECRET=

# Legacy compatibility only for an existing admin-created custom app:
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx

# Email (Resend REST API)
RESEND_API_KEY=re_xxx
EMAIL_FROM=ParadiseBlox <orders@mail.paradiseblox.com>

# Links
TRUSTPILOT_REVIEW_URL=https://www.trustpilot.com/review/paradiseblox.com
SUPPORT_URL=https://paradiseblox.com/pages/help-center

# Background jobs (Supabase scheduler calls /api/cron/tick with this)
CRON_SECRET=make-a-long-random-string

# Phone alerts for the admin (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@paradiseblox.com

# Optional. Where customer replies to emails go. Defaults to support@paradiseblox.com
REPLY_TO_EMAIL=
